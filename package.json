{
  "name": "oax",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "setup:browser": "node scripts/setup-browser.mjs",
    "test:browser": "tsx scripts/test-browser.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:editor": "node scripts/test-editor.mjs",
    "demo": "node dist/cli.cjs demo",
    "schemas": "tsx scripts/schemas.ts",
    "package:local": "node scripts/package.mjs",
    "test:live": "tsx scripts/test-live-codex.ts",
    "test:neovim": "node scripts/test-neovim.mjs"
  },
  "devDependencies": {
    "@oax/browser": "workspace:*",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@oax/codegraph": "workspace:*",
    "@oax/codex": "workspace:*",
    "@oax/context": "workspace:*",
    "@oax/git": "workspace:*",
    "@oax/indexer": "workspace:*",
    "@oax/permissions": "workspace:*",
    "@oax/protocol": "workspace:*",
    "@oax/runtime": "workspace:*",
    "@oax/spatial": "workspace:*",
    "@oax/watcher": "workspace:*",
    "@puppeteer/browsers": "3.2.3",
    "@types/node": "24.10.1",
    "@types/vscode": "1.105.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "4.0.0",
    "chrome-devtools-mcp": "1.10.1",
    "esbuild": "0.25.12",
    "eslint": "10.11.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "@oax/github": "workspace:*",
    "@oax/buddy": "workspace:*"
  }
}
