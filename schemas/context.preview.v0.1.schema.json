{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "memoryIds": {
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "observation": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "uri": { "type": "string", "maxLength": 8192 },
        "documentVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "dirty": { "type": "boolean" },
        "text": { "type": "string", "maxLength": 131072 },
        "cursor": {
          "type": "object",
          "properties": {
            "line": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "column": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["line", "column"],
          "additionalProperties": false
        },
        "selection": {
          "type": "object",
          "properties": {
            "start": {
              "type": "object",
              "properties": {
                "line": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "column": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["line", "column"],
              "additionalProperties": false
            },
            "end": {
              "type": "object",
              "properties": {
                "line": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "column": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["line", "column"],
              "additionalProperties": false
            }
          },
          "required": ["start", "end"],
          "additionalProperties": false
        },
        "visibleRanges": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": {
                "type": "object",
                "properties": {
                  "line": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "column": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": ["line", "column"],
                "additionalProperties": false
              },
              "end": {
                "type": "object",
                "properties": {
                  "line": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "column": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": ["line", "column"],
                "additionalProperties": false
              }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          }
        },
        "openFiles": {
          "maxItems": 100,
          "type": "array",
          "items": { "type": "string", "maxLength": 4096 }
        }
      },
      "required": [
        "path",
        "uri",
        "documentVersion",
        "dirty",
        "text",
        "cursor",
        "selection",
        "visibleRanges",
        "openFiles"
      ],
      "additionalProperties": false
    },
    "objective": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "history": { "type": "string", "enum": ["local", "github"] }
  },
  "required": ["observation", "objective"],
  "additionalProperties": false
}
