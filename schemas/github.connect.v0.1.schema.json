{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "repository": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*\\/[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "accessToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^\\S+$"
    },
    "approved": { "type": "boolean", "const": true }
  },
  "required": ["repository", "accessToken", "approved"],
  "additionalProperties": false
}
