{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "planId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "approvedHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": ["planId", "approvedHash"],
  "additionalProperties": false
}
